{
  "manifest_version": 3,
  "name": "BiliPrism 映棱",
  "short_name": "BiliPrism",
  "version": "0.1.6",
  "description": "MARGIN 风格界面、清晰文字、原生播放器增强、树状评论与可定制动态页。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://message.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "comments-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/*"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
